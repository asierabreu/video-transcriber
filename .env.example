# Required API authentication key (minimum 32 characters).
# Generate one with: make api-key
API_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLISH=8000
DOCS_ENABLED=false

# Storage and limits
# Use ./ paths for native development; Docker uses /data and /models.
DATA_DIR=/data
MODELS_DIR=/models
MAX_UPLOAD_MB=8192
MAX_DURATION_S=14400
ALLOWED_CONTAINERS=mp4,mkv,mov,avi
MAX_QUEUED_JOBS=50
MIN_FREE_DISK_GB=20
KEEP_MEDIA=false
RETENTION_DAYS=2

# Hardware and ASR
DEVICE=auto
# ASR_MODEL=
# ASR_COMPUTE_TYPE=
# ASR_BATCH_SIZE=
ASR_BEAM_SIZE=5
# CPU_THREADS=

# Diarization
# DIARIZATION_MODEL=
# DIARIZATION_DEVICE=

# LLM / Ollama
OLLAMA_URL=http://ollama:11434
# For native development use: http://localhost:11434
# LLM_MODEL=
# LLM_NUM_CTX=
LLM_MAP_CONCURRENCY=2
LLM_TIMEOUT_S=300
LLM_MAX_EDIT_RATIO=0.25
LLM_KEEP_ALIVE=5m
OLLAMA_TAG=0.12.6

# Worker
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_S=2
JOB_MAX_ATTEMPTS=3

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Third-party library switches
HF_HUB_OFFLINE=true
PYANNOTE_METRICS_ENABLED=false

# Used only by make models / scripts/download_models.py.
# Accept the pyannote model conditions before creating this token.
HF_TOKEN=
